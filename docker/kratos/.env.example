# Secrets de Kratos : chaînes aléatoires (au moins 32 caractères pour COOKIE, exactement 32 pour CIPHER).
# Par exemple : openssl rand -hex 32  et  openssl rand -hex 16
KRATOS_SECRET_COOKIE=
KRATOS_SECRET_CIPHER=
# Envoi des emails (codes de vérification et de récupération). Exemple : smtps://utilisateur:mot-de-passe@smtp.exemple.org:465/
SMTP_URI=
SMTP_FROM=wiki@exemple.org
